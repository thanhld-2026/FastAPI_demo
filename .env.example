# Copy file này thành .env rồi sửa giá trị:  cp .env.example .env
# File .env chứa thông tin nhạy cảm -> KHÔNG commit lên git (đã có trong .gitignore)

# --- App ---
APP_NAME="TaskHub API"
ENVIRONMENT=development

# --- Database (PostgreSQL) ---
# Dùng cho docker-compose (service db)
POSTGRES_USER=taskhub
POSTGRES_PASSWORD=taskhub
POSTGRES_DB=taskhub
# Dùng khi chạy app ở máy local (host = localhost)
DATABASE_URL=postgresql+psycopg://taskhub:taskhub@localhost:5432/taskhub
DB_ECHO=false

# --- JWT ---
# Tạo key ngẫu nhiên:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
