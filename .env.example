# Copy file này thành .env rồi sửa giá trị:  cp .env.example .env
# File .env chứa thông tin nhạy cảm -> KHÔNG commit lên git (đã có trong .gitignore)

# --- App ---
APP_NAME="TaskHub API"
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# --- Database (PostgreSQL) ---
# Dùng cho docker-compose (service db)
POSTGRES_USER=taskhub
POSTGRES_PASSWORD=taskhub
POSTGRES_DB=taskhub
# Dùng khi chạy app ở máy local (host = localhost). Trong docker-compose sẽ được override thành host = db
DATABASE_URL=postgresql+psycopg://taskhub:taskhub@localhost:5432/taskhub
DB_ECHO=false

# --- JWT ---
# Tạo key ngẫu nhiên:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS (định dạng JSON list) ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Redis cache (để trống = tắt cache) ---
REDIS_URL=redis://localhost:6379/0
TAGS_CACHE_TTL=300

# --- Email (Mailpit trong docker-compose: xem mail tại http://localhost:8025) ---
EMAIL_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM="TaskHub <no-reply@taskhub.local>"
